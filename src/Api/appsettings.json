{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AppointmentBooking": {
    "TimeZoneId": "America/Bogota",
    "MinimumLeadMinutes": 60,
    "MaximumAdvanceDays": 30
  },
  "ContactVerification": {
    "OtpTtlMinutes": 10,
    "OtpMaximumAttempts": 5,
    "OtpResendSeconds": 60,
    "ProofTtlMinutes": 15
  },
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60,
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "RefreshPermitLimit": 20,
    "RefreshWindowSeconds": 60,
    "RegisterPermitLimit": 5,
    "RegisterWindowSeconds": 60,
    "TelegramWebhookPermitLimit": 120,
    "TelegramWebhookWindowSeconds": 60,
    "ClientIdentificationLookupPermitLimit": 20,
    "ClientIdentificationLookupWindowSeconds": 60,
    "ClientPhoneLookupPermitLimit": 20,
    "ClientPhoneLookupWindowSeconds": 60,
    "AppointmentOtpRequestPermitLimit": 5,
    "AppointmentOtpRequestWindowSeconds": 60,
    "AppointmentOtpConfirmPermitLimit": 10,
    "AppointmentOtpConfirmWindowSeconds": 60,
    "ContactEmailRequestPermitLimit": 5,
    "ContactEmailRequestWindowSeconds": 60,
    "ContactEmailConfirmPermitLimit": 10,
    "ContactEmailConfirmWindowSeconds": 60,
    "EmailOtpRequestPermitLimit": 5,
    "EmailOtpRequestWindowSeconds": 60,
    "EmailOtpConfirmPermitLimit": 10,
    "EmailOtpConfirmWindowSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
