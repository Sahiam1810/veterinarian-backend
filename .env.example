# Copie este archivo como .env y complete los valores locales / VPS.
# No guarde secretos reales en este archivo ni los suba al repositorio.
# Producción (stack): ../docker-compose.prod.yml — ver ../DEPLOY.md
#
# Dominios de despliegue:
#   API:      https://api.huellitas.chatcampuslands.com
#   Frontend: https://huellitas.chatcampuslands.com
# Docker local: API en http://127.0.0.1:5233 (compose local).
# Docker prod:  API publicada solo en 127.0.0.1:5233 (Nginx del host).
#
# Connection string (credenciales SOLO aquí / en VPS .env; nunca en YAML Compose):
#   Docker (prod/local compose): Data Source=//oracle:1521/FREEPDB1
#   Oracle en host desde contenedor: Data Source=//host.docker.internal:1522/FREEPDB1
#   dotnet run en host: Data Source=//localhost:1522/FREEPDB1
# Ejemplo de forma (rellenar User Id / Password en el .env real):
#   User Id=VET_APP;Password=;Data Source=//oracle:1521/FREEPDB1
ConnectionStrings__DefaultConnection=

# Variables de la imagen gvenzl/oracle-free (compose local y prod leen este .env).
# Dejar vacías en el example; definir solo en .env del VPS / máquina local.
ORACLE_PASSWORD=
APP_USER=VET_APP
APP_USER_PASSWORD=
# PEM PKCS#8 privado y PEM SubjectPublicKeyInfo publico, ambos codificados
# completamente en Base64. La clave privada solo pertenece al backend .NET.
Jwt__PrivateKeyPemBase64=
Jwt__PublicKeyPemBase64=
Jwt__KeyId=
Jwt__Issuer=Veterinaria.Api
Jwt__Audience=Veterinaria.Client
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30
Jwt__MaxSessionHours=24
Jwt__ClockSkewSeconds=0

# Credenciales para autenticación básica HTTP en Swagger UI (/swagger)
SWAGGER_USER=cambia-este-usuario
SWAGGER_PASSWORD=cambia-esta-clave



# Origenes permitidos para CORS (uno por indice).
# Producción: únicamente el frontend público.
Cors__AllowedOrigins__0=https://huellitas.chatcampuslands.com
# Local (Vite en 5174): descomente solo en desarrollo.
# Cors__AllowedOrigins__1=http://localhost:5174

# Gateway interno hacia Huellitas ChatBot.
# Local (dotnet run): http://127.0.0.1:8010 -- use la IP, no "localhost": en
# Windows "localhost" puede resolver primero a ::1 (IPv6) y el chatbot solo
# escucha en 127.0.0.1 (IPv4), causando fallos intermitentes de conexión.
# Docker prod (huellitas_network): http://chatbot:8010  ← docker-compose.prod.yml lo fija
# Docker local (este repo):        http://chatbot:8010  ← docker-compose.yml lo fija
Agent__Enabled=false
Agent__BaseUrl=http://127.0.0.1:8010
Agent__MessagesPath=/api/v1/messages
Agent__RequestTimeoutSeconds=90
Agent__MaxResponseBytes=1048576
Agent__InitialConversationStatusId=81000000-0000-0000-0000-000000000001
Agent__ClientParticipantTypeId=82000000-0000-0000-0000-000000000001

# Canal Telegram. Cuando Enabled=false los valores externos pueden quedar vacios.
# PublicWebhookUrl es la URL HTTPS publica del backend, sin la ruta del webhook.
Telegram__Enabled=false
# Permite preguntas generales sin verificar identidad. Cuando el agente detecta
# datos u operaciones privadas, el backend solicita cedula y OTP automaticamente.
Telegram__GuestModeEnabled=false
Telegram__BotToken=
Telegram__BotUsername=
Telegram__WebhookSecret=
Telegram__PublicWebhookUrl=https://api.huellitas.chatcampuslands.com
Telegram__WorkerPollMilliseconds=30000
# Slots paralelos del worker (chats distintos). Empezar en 1 y subir a 8 → 16–24 midiendo.
Telegram__WorkerConcurrency=16
Telegram__ProcessingLeaseSeconds=300
Telegram__MaxProcessingAttempts=3
Telegram__DelegatedTokenMinutes=5
# Estado "Pendiente" de ESCALATIONS_STATUSES (sembrado en chat_runtime_catalogs_seed.sql).
# Se usa al crear un ChatEscalation automatico al detectar una frase de asesor.
Telegram__PendingEscalationStatusId=85000000-0000-0000-0000-000000000001
# Tipo "Texto" de MESSAGE_TYPES (sembrado en chat_runtime_catalogs_seed.sql).
# Se usa al persistir el mensaje del cliente vinculado en CHAT_MESSAGES.
Telegram__TextMessageTypeId=83000000-0000-0000-0000-000000000001
# SENDER_TYPES "Agente humano" (sembrado en chat_conversation_catalogs_seed.sql).
# Decide si un ChatMessage se reenvia al cliente por Telegram.
Telegram__HumanAgentSenderTypeId=82000000-0000-0000-0000-000000000003

# Estado "Resuelta" de ESCALATIONS_STATUSES (sembrado en chat_runtime_catalogs_seed.sql).
# Independiente de Telegram/Agent: se usa al crear una ChatEscalationResolution
# para sincronizar el estado del ChatEscalation asociado.
Chat__ResolvedEscalationStatusId=85000000-0000-0000-0000-000000000004

# Pepper aleatorio de al menos 32 bytes, codificado en Base64.
Telegram__OtpPepperBase64=
Telegram__PrivateAccessAbsoluteTtlHours=24
Telegram__PrivateAccessIdleTtlMinutes=30

# Evita registrar cada consulta EF exitosa del sondeo de respaldo.
Serilog__MinimumLevel__Override__Microsoft.EntityFrameworkCore.Database.Command=Warning

# SMTP para enviar el OTP de vinculacion. Use una clave de aplicacion cuando
# el proveedor lo exija; nunca escriba aqui la contrasena del usuario final.
Email__Enabled=false
Email__Host=
Email__Port=587
Email__Username=
Email__Password=
Email__FromAddress=
Email__FromName=Huellitas
Email__UseTls=true

# OTP de contacto (Etapa 3 / ContactVerification). Canal v1 solo Email/Gmail.
# Distinto del OTP de Telegram. No WhatsApp/SMS aquí.
# Suite aceptación: docs/smoke/etapa-3-contact-email-exit-gate.md
# Pepper vacío reutiliza Telegram__OtpPepperBase64. La sección AppointmentVerification__* se retiró:
# si tu entorno tenía el pepper solo ahí, muévelo a ContactVerification__OtpPepperBase64.
ContactVerification__OtpTtlMinutes=10
ContactVerification__OtpMaximumAttempts=5
ContactVerification__OtpResendSeconds=60
ContactVerification__ProofTtlMinutes=15
ContactVerification__OtpPepperBase64=

# RegisterOwner (Etapa 4). Bot siempre ConsumeProof Email.
# Telegram: equivalencia OTP de sesión (sin ContactVerification).
# Staff: false = alta en escritorio sin OTP; true = mismo proof que el bot.
# No crea USER_ACCOUNTS ni password. WhatsApp/SMS de contacto fuera de alcance.
RegisterOwner__RequireContactProofs=false

# Rate limit HTTP anónimo ContactVerification (tarea 3.3). Sin JWT.
# 429 → problem+json code RateLimit.Exceeded
RateLimiting__ContactEmailRequestPermitLimit=5
RateLimiting__ContactEmailRequestWindowSeconds=60
RateLimiting__ContactEmailConfirmPermitLimit=10
RateLimiting__ContactEmailConfirmWindowSeconds=60

# Rate limit POST /api/owners/bot (tarea 4.2). Anónimo; proof Email ya emitido en Etapa 3.
RateLimiting__BotOwnerRegistrationPermitLimit=5
RateLimiting__BotOwnerRegistrationWindowSeconds=60

# Twilio SMS/WhatsApp (canal del mecanismo genérico de verificación).
Twilio__Enabled=false
Twilio__AccountSid=
Twilio__AuthToken=
Twilio__FromNumber=
Twilio__WhatsAppFrom=
Twilio__DefaultCountryCode=57

# Generador de recordatorios de citas próximas (Módulo 10). Revisa cada
# PollIntervalMinutes las citas agendadas dentro de las próximas WindowHours
# y crea una notificación (empujada también por SignalR) si aún no existe.
Reminders__Enabled=true
Reminders__WindowHours=24
Reminders__PollIntervalMinutes=15

# Nombres de estados de cita a excluir (deben coincidir con el catálogo de
# StatusAppointments ya creado). Ejemplo: Reminders__ExcludedStatusNames__0=Cancelada

# Aviso Telegram al dueno ~1 hora antes. Requiere Telegram__Enabled=true.
# No reemplaza Reminders (panel SignalR a 24 h).
TelegramReminders__Enabled=true
TelegramReminders__LeadMinutes=60
TelegramReminders__GraceMinutes=10
TelegramReminders__PollIntervalMinutes=5
TelegramReminders__AllowedStatusNames__0=AGENDADA
TelegramReminders__AllowedStatusNames__1=CONFIRMADA

# Agendamiento conversacional: calcula horarios locales y retorna instantes UTC.
AppointmentBooking__TimeZoneId=America/Bogota
AppointmentBooking__MinimumLeadMinutes=60
AppointmentBooking__MaximumAdvanceDays=30


